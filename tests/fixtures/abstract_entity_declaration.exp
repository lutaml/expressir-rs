SCHEMA abstract_probe;
ENTITY a ABSTRACT;
END_ENTITY;
ENTITY b
  ABSTRACT
  SUBTYPE OF (a);
END_ENTITY;
ENTITY c
  ABSTRACT SUPERTYPE;
END_ENTITY;
ENTITY d
  ABSTRACT SUPERTYPE OF (ONEOF (e, f));
END_ENTITY;
ENTITY e
  ABSTRACT SUPERTYPE
  SUBTYPE OF (a);
END_ENTITY;
ENTITY f
  abstract
  subtype of (a);
END_ENTITY;
ENTITY g
  abstract supertype
  subtype of (a);
END_ENTITY;
ENTITY h
  SUPERTYPE OF (ONEOF (i, j));
END_ENTITY;
ENTITY i
  SUBTYPE OF (h);
END_ENTITY;
ENTITY j
  SUBTYPE OF (h);
END_ENTITY;
END_SCHEMA;
